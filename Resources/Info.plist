<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>LifeNotch</string>
    <key>CFBundleDisplayName</key>
    <string>LifeNotch</string>
    <key>CFBundleIdentifier</key>
    <string>com.lifenotch.app</string>
    <key>CFBundleExecutable</key>
    <string>LifeNotch</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- LSUIElement = no Dock icon and no menu bar title. LifeNotch lives in the notch
         (and a small menu-bar icon so you can always quit it). -->
    <key>LSUIElement</key>
    <true/>

    <!-- Lets other things (Shortcuts, the optional Safari extension) talk to LifeNotch
         with links that start with lifenotch:// . Every link is checked by the app first. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.lifenotch.app.url</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>lifenotch</string>
            </array>
        </dict>
    </array>

    <!-- These two sentences are only shown if YOU press "Scan" in Clean Desk.
         LifeNotch never opens these folders by itself. -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>LifeNotch only looks inside Desktop when you press Scan in Clean Desk. It never deletes or moves anything.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>LifeNotch only looks inside Downloads when you press Scan in Clean Desk. It never deletes or moves anything.</string>

    <!-- Each of these sentences is shown by macOS ONLY when you use the matching feature,
         after LifeNotch has already asked you in plain words. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>LifeNotch asks Music or Spotify what is playing and sends play, pause and skip when you press its buttons in the Now Playing tab.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>LifeNotch shows your upcoming events and adds events you create with Quick Add. It keeps nothing outside your Mac.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>LifeNotch shows your upcoming events and adds events you create with Quick Add.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>LifeNotch adds reminders you create with Quick Add.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>LifeNotch records your voice only while you press Record in Voice Notes. The recording is deleted after it is turned into text.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>LifeNotch turns your Voice Notes recording into text on this Mac.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- Not included: camera, contacts, location. Screen Recording and Accessibility have no
         text here: macOS shows its own screen when you use screen capture or window snapping. -->
</dict>
</plist>
